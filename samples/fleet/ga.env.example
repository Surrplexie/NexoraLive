# Phase 6 general availability — hosted fleet with multi-game catalog + SLA + compliance
NL_GA_ENABLED=true
NL_GA_OPEN_SIGNUP=true
NL_GA_REQUIRE_LIVE_IDENTITY=true
NL_GA_ALLOW_MOCK_IDENTITY=false
NL_GA_REQUIRE_PRODUCTION_READY=true
NL_GA_REQUIRE_BETA_DISABLED=true
NL_GA_MIN_CATALOG_GAMES=3
NL_GA_REQUIRED_GAMES=hello-fork,minecraft,beamng
NL_GA_SLA_TIER=standard

NL_BETA_ENABLED=false

NL_PUBLIC_MODE=true
NL_FLEET_ENABLED=true
NL_FLEET_PRODUCTION_READY=true
NL_FLEET_STAGING_DEV=false
NL_FLEET_MIN_TWITCH_FOLLOWERS=50
NL_FLEET_MOD_RETENTION_DAYS=730

NL_FORK_CATALOG_ENABLED=true
NL_FORK_CATALOG_MANIFEST=/app/samples/fork/catalog.json

NL_OWNERSHIP_MODE=live
NL_IDENTITY_ENABLED=true
STEAM_WEB_API_KEY=

NL_OPERATOR_KEY=change-me
NL_BUS_TOKEN=change-me

NL_PUBLIC_BASE_URL=https://play.yourdomain.com
NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.yourdomain.com/fork/{session}
NL_FLEET_TURN_URI=turn:turn.yourdomain.com:3478?transport=udp

NL_FORK_ORCHESTRATOR_MODE=docker
NL_FORK_DOCKER_IMAGE=nl-fork-hello:latest
