# Phase 5 public beta — hosted fleet with waitlist + live identity
NL_BETA_ENABLED=true
NL_BETA_WAITLIST_OPEN=true
NL_BETA_MAX_STREAMERS=100
NL_BETA_ENFORCE_ALLOWLIST=true
NL_BETA_ALLOW_MOCK_IDENTITY=false
NL_BETA_REQUIRE_PRODUCTION_READY=true
NL_BETA_OPERATOR_STREAMERS=dogfood-streamer

NL_PUBLIC_MODE=true
NL_FLEET_ENABLED=true
NL_FLEET_PRODUCTION_READY=true
NL_FLEET_STAGING_DEV=false
NL_FLEET_MIN_TWITCH_FOLLOWERS=50

NL_OWNERSHIP_MODE=live
NL_IDENTITY_ENABLED=true
STEAM_WEB_API_KEY=

NL_OPERATOR_KEY=change-me
NL_BUS_TOKEN=change-me

NL_PUBLIC_BASE_URL=https://beta.yourdomain.com
NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.beta.yourdomain.com/fork/{session}
NL_FLEET_TURN_URI=turn:turn.beta.yourdomain.com:3478?transport=udp

NL_FORK_ORCHESTRATOR_MODE=docker
NL_FORK_DOCKER_IMAGE=nl-fork-hello:latest
