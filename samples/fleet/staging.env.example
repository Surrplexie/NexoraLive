# Staging fleet validation environment (copy to .env for docker-compose.staging-fleet.yml)
NL_FLEET_ENABLED=true
NL_FLEET_MAX_CONCURRENT=128
NL_FLEET_MIN_TWITCH_FOLLOWERS=0
NL_FLEET_FORK_CREATE_RATE_PER_MIN=120
NL_FLEET_STAGING_DEV=true
NL_FLEET_RELAY_WS_TEMPLATE=wss://127.0.0.1:8443/fork/{session}
NL_FLEET_TURN_URI=turn:127.0.0.1:3478?transport=udp
NL_FORK_ORCHESTRATOR_ENABLED=true
NL_FORK_ORCHESTRATOR_MODE=mock
# Production cluster:
# NL_FORK_ORCHESTRATOR_MODE=kubernetes
# NL_FORK_K8S_NAMESPACE=nl-fork
# NL_FLEET_PRODUCTION_READY=true
