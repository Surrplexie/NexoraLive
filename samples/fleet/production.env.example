# Production fleet environment (VPS or local docker-compose.production-fleet.yml)
# Copy to docker/production-fleet.env and set host-specific paths/secrets.

NL_FLEET_ENABLED=true
NL_FLEET_MAX_CONCURRENT=128
NL_FLEET_MIN_TWITCH_FOLLOWERS=50
NL_FLEET_FORK_CREATE_RATE_PER_MIN=200
NL_FLEET_MAX_FORK_CREATES_PER_HOUR=9999
NL_FLEET_STAGING_DEV=false
NL_FLEET_PRODUCTION_READY=true

# Public URLs — replace with real domains on VPS
NL_PUBLIC_BASE_URL=https://staging.yourdomain.com
NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.staging.yourdomain.com/fork/{session}
NL_FLEET_TURN_URI=turn:turn.staging.yourdomain.com:3478?transport=udp

# Orchestrator — Docker (single-node VPS) or kubernetes (cluster)
NL_FORK_ORCHESTRATOR_ENABLED=true
NL_FORK_ORCHESTRATOR_MODE=docker
NL_FORK_DOCKER_IMAGE=nl-fork-hello:latest
NL_FORK_DOCKER_HOST=host.docker.internal

# Required when session-host runs in Docker but forks use host docker.sock
# Set to absolute HOST path of the bind-mounted NL data directory (forward slashes OK)
# NL_FORK_DOCKER_WORKSPACE_HOST_ROOT=/opt/nexoralive/docker/production-data

# Kubernetes cluster (multi-node production)
# NL_FORK_ORCHESTRATOR_MODE=kubernetes
# NL_FORK_K8S_NAMESPACE=nl-fork
# NL_FORK_K8S_KUBECONFIG=

NL_IDENTITY_ENABLED=true
NL_OWNERSHIP_MODE=live
NL_OPERATOR_KEY=change-me
STEAM_WEB_API_KEY=
