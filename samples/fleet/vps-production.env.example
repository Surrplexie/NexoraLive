# Copy to docker/vps-production-fleet.env — VPS production secrets (NEVER commit)
# Generate: bash scripts/nl-vps-init-env.sh

# ── Domain (must match DNS + docker/.env.vps) ───────────────────────────────
NL_PUBLIC_BASE_URL=https://play.yourdomain.com
NL_PUBLIC_HTTP=https://play.yourdomain.com
NL_PUBLIC_WS=wss://play.yourdomain.com/nl/v1
NL_PUBLIC_HOST=play.yourdomain.com
NL_FORK_PUBLIC_CONNECT_HOST=play.yourdomain.com
NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.yourdomain.com/fork/{session}
NL_FLEET_TURN_URI=turn:turn.yourdomain.com:3478?transport=udp

# ── Secrets (openssl rand -hex 16) ──────────────────────────────────────────
NL_OPERATOR_KEY=change-me
NL_BUS_TOKEN=change-me
STEAM_WEB_API_KEY=
TURN_SECRET=change-me-turn-secret

# ── Live admit (Steam ownership + optional Twitch social) ───────────────────
NL_OWNERSHIP_MODE=live
NL_SOCIAL_MODE=live
# Keep 0 until Twitch OAuth client id/secret are set and streamer is linked.
# Raise to 50 for public GA when live social is proven.
NL_FLEET_MIN_TWITCH_FOLLOWERS=0
# Raise for Path A load test / public-ready cutover; production default is 30 / 6.
NL_FLEET_FORK_CREATE_RATE_PER_MIN=200
NL_FLEET_MAX_FORK_CREATES_PER_HOUR=9999

# ── OAuth (Twitch required for live social / follower floor) ────────────────
# Redirect: https://play.yourdomain.com/api/v1/social/oauth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Redirect: https://play.yourdomain.com/api/v1/social/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=

# ── Launch ops ──────────────────────────────────────────────────────────────
NL_PUBLIC_GA_SUPPORT_CONTACT=support@yourdomain.com
NL_PUBLIC_GA_LAUNCH_VERSION=2026-08-01
NL_LAUNCH_ALERT_WEBHOOK_URL=
NL_DISTRIBUTION_CLIENT_VERSION=1.0.0

# ── Fork docker workspace (host path for fork volumes) ──────────────────────
NL_FORK_DOCKER_WORKSPACE_HOST_ROOT=/var/lib/nl/vps-fork-workspace

# ── Production fleet limits ─────────────────────────────────────────────────
# (Follower floor + fork create rates are set under Live admit above.)
NL_FLEET_MOD_RETENTION_DAYS=730
