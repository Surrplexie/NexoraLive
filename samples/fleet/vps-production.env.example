# Copy to docker/vps-production-fleet.env — VPS production secrets (NEVER commit)
# Generate: bash scripts/nl-vps-init-env.sh

# ── Domain (must match DNS + docker/.env.vps) ───────────────────────────────
NL_PUBLIC_BASE_URL=https://play.yourdomain.com
NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.yourdomain.com/fork/{session}
NL_FLEET_TURN_URI=turn:turn.yourdomain.com:3478?transport=udp

# ── Secrets (openssl rand -hex 16) ──────────────────────────────────────────
NL_OPERATOR_KEY=change-me
NL_BUS_TOKEN=change-me
STEAM_WEB_API_KEY=
TURN_SECRET=change-me-turn-secret

# ── OAuth (optional until live social/identity dogfood) ─────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=

# ── Launch ops ──────────────────────────────────────────────────────────────
NL_PUBLIC_GA_SUPPORT_CONTACT=support@yourdomain.com
NL_PUBLIC_GA_LAUNCH_VERSION=2026-08-01
NL_LAUNCH_ALERT_WEBHOOK_URL=
NL_DISTRIBUTION_CLIENT_VERSION=1.0.0

# ── Fork docker workspace (host path for fork volumes) ──────────────────────
NL_FORK_DOCKER_WORKSPACE_HOST_ROOT=/var/lib/nl/vps-fork-workspace

# ── Production fleet limits ─────────────────────────────────────────────────
NL_FLEET_MIN_TWITCH_FOLLOWERS=50
NL_FLEET_MAX_FORK_CREATES_PER_HOUR=6
NL_FLEET_FORK_CREATE_RATE_PER_MIN=30
NL_FLEET_MOD_RETENTION_DAYS=730
