# Phase L.3 — Epic, Xbox, PlayStation OAuth + live ownership
NL_IDENTITY_ENABLED=true
NL_OWNERSHIP_MODE=live
NL_PUBLIC_BASE_URL=http://127.0.0.1:27020

# Epic Games Developer Portal
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/identity/oauth/epic/callback
EPIC_CLIENT_ID=your-epic-client-id
EPIC_CLIENT_SECRET=your-epic-client-secret

# Microsoft / Xbox Live app registration
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/identity/oauth/xbox/callback
XBOX_CLIENT_ID=your-xbox-client-id
XBOX_CLIENT_SECRET=your-xbox-client-secret

# PlayStation Partners / DevNet
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/identity/oauth/playstation/callback
PSN_CLIENT_ID=your-psn-client-id
PSN_CLIENT_SECRET=your-psn-client-secret

# Optional Steam (Phase L)
# STEAM_WEB_API_KEY=

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
