# Account verification — email + TOTP 2FA (SpVerification)
NL_VERIFICATION_ENABLED=true
NL_VERIFICATION_DEV_EXPOSE_CODES=true
NL_EMAIL_MODE=mock

# Optional SMTP (set NL_EMAIL_MODE=smtp when configured)
# NL_EMAIL_SMTP_HOST=smtp.example.com
# NL_EMAIL_SMTP_PORT=587
# NL_EMAIL_SMTP_USER=
# NL_EMAIL_SMTP_PASSWORD=
# NL_EMAIL_FROM=noreply@example.com

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
