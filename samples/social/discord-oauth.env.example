# Phase M.2 — Discord OAuth (player linking + guild membership)
NL_SOCIAL_ENABLED=true
NL_SOCIAL_MODE=live
NL_PUBLIC_BASE_URL=http://127.0.0.1:27020

# Discord developer portal: https://discord.com/developers/applications
# Redirect URI: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/discord/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Set streamer guild id in join gate UI (/join-gate.html) or streamer-social.json

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
