# Phase M.4 — Kick OAuth (player account linking, OAuth 2.1 + PKCE)
NL_SOCIAL_ENABLED=true
NL_SOCIAL_MODE=live
NL_PUBLIC_BASE_URL=http://127.0.0.1:27020

# Kick developer app: https://kick.com/settings/developer
# Redirect URI: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/kick/callback
# Use localhost (not 127.0.0.1) for local redirect URIs when possible.
KICK_CLIENT_ID=your-kick-client-id
KICK_CLIENT_SECRET=your-kick-client-secret

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
