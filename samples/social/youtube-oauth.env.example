# Phase M.3 — YouTube OAuth (player account linking)
NL_SOCIAL_ENABLED=true
NL_SOCIAL_MODE=live
NL_PUBLIC_BASE_URL=http://127.0.0.1:27020

# Google Cloud OAuth client: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 for the project.
# Redirect URI: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/youtube/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
