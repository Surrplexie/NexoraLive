# Live social dogfood — copy to docker/live-social-dogfood.env or dot-source before host start
# Docs: docs/NL_LIVE_SOCIAL_DOGFOOD.md

NL_PUBLIC_BASE_URL=http://127.0.0.1:27020
NL_DATA_ROOT=
NL_SOCIAL_ROOT=

# Social gate (mock = fixture relationships; live = real platform APIs for follow/sub/discord)
NL_SOCIAL_ENABLED=true
NL_SOCIAL_MODE=mock
NL_SOCIAL_CACHE_TTL_SEC=300
NL_LIVE_CHECK_INTERVAL_SEC=60

# Session host dogfood defaults
NL_FLEET_ENABLED=true
NL_FLEET_MIN_TWITCH_FOLLOWERS=0
NL_FLEET_MAX_FORK_CREATES_PER_HOUR=999
NL_FORK_ORCHESTRATOR_ENABLED=true
NL_FORK_ORCHESTRATOR_MODE=docker
NL_IDENTITY_ENABLED=true
NL_OWNERSHIP_MODE=mock

# ── Live mode OAuth (required when NL_SOCIAL_MODE=live) ─────────────────────
# Twitch: https://dev.twitch.tv/console/apps
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# TWITCH_ACCESS_TOKEN=

# Discord: https://discord.com/developers/applications
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# YouTube (Google Cloud OAuth): https://console.cloud.google.com/apis/credentials
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Kick: https://kick.com/settings/developer
# Redirect: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional — override dogfood streamer channel ids (applied by nl-live-social-dogfood-setup.ps1)
# DOGFOOD_TWITCH_BROADCASTER_ID=
# DOGFOOD_DISCORD_GUILD_ID=
# DOGFOOD_YOUTUBE_CHANNEL_ID=
# DOGFOOD_KICK_SLUG=dogfood
