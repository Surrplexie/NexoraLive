# Phase M.1 — Twitch OAuth (player account linking)
NL_SOCIAL_ENABLED=true
NL_SOCIAL_MODE=live
NL_PUBLIC_BASE_URL=http://127.0.0.1:27020

# Twitch developer app: https://dev.twitch.tv/console/apps
# Redirect URI: {NL_PUBLIC_BASE_URL}/api/v1/social/oauth/twitch/callback
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Optional legacy server token (used when player has not OAuth-linked yet)
# TWITCH_ACCESS_TOKEN=

# Linux token encryption (32-byte base64); Windows uses DPAPI when unset
# NL_IDENTITY_ENCRYPTION_KEY=
