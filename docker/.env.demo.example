# Copy to docker/.env before: docker compose -f docker/docker-compose.demo.yml --env-file docker/.env up -d
# Local Windows (no Docker): powershell -File scripts/deploy-demo-native.ps1

NL_DEMO_DOMAIN=localhost

# Generated secrets — rotate before any public VPS deploy (openssl rand -hex 32)
NL_BUS_TOKEN=replace-with-openssl-rand-hex-32
NL_OPERATOR_KEY=replace-with-openssl-rand-hex-32

NL_PUBLIC_HTTP=http://localhost
NL_PUBLIC_WS=ws://localhost/nl/v1
NL_PUBLIC_MOD_HTTP=http://localhost
NL_CORS_ORIGINS=http://localhost

# Optional: Let's Encrypt contact email (production domain only)
# CADDY_ACME_EMAIL=you@example.com

# Optional: pre-built GHCR image
# NL_SESSION_IMAGE=ghcr.io/surrplexie/nexoralive/session-server:latest
