# Caddy + compose driver env — copy to docker/.env.vps
# Used by: docker compose -f docker/docker-compose.vps-production.yml --env-file docker/.env.vps

# Primary play URL (must match NL_PUBLIC_BASE_URL host)
NL_VPS_DOMAIN=play.yourdomain.com

# Apex domain for relay-us-east.{base}, relay-us-west.{base}, relay-eu-west.{base}
NL_VPS_BASE_DOMAIN=yourdomain.com

# Let's Encrypt contact
CADDY_ACME_EMAIL=you@yourdomain.com

# Optional TURN hostname override for coturn command (defaults in compose)
TURN_SECRET=change-me-turn-secret

# Host path bind-mounted to session-host /data (must match fleet env)
NL_FORK_DOCKER_WORKSPACE_HOST_ROOT=/var/lib/nl/vps-fork-workspace
