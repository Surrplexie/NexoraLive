# NexoraLive — environment variables for public demo / Docker deployment (Phase E)
# Copy to .env and replace placeholder secrets before exposing the session server publicly.

# --- Public demo mode (required for internet-facing deploy) ---
# When enabled, NL_BUS_TOKEN and NL_OPERATOR_KEY become mandatory at startup.
NL_PUBLIC_MODE=false

# Fixed WebSocket bridge token (game bridges use ?token= on /nl/v1). Do not rotate casually in production.
NL_BUS_TOKEN=change-me-use-openssl-rand-hex-32

# Operator API key for session control + moderation writes (header: X-NL-Operator-Key or Authorization: Bearer).
NL_OPERATOR_KEY=change-me-use-openssl-rand-hex-32

# --- Network bind + ports ---
NL_BIND=127.0.0.1
NL_HTTP_PORT=27020
NL_WS_PORT=27021
NL_MOD_HTTP_PORT=27030

# --- Public URL overrides (manifest / bridge URLs behind reverse proxy + TLS) ---
# NL_PUBLIC_HOST=demo.example.com
# NL_PUBLIC_HTTP=https://demo.example.com
# NL_PUBLIC_WS=wss://demo.example.com/nl/v1
# NL_PUBLIC_MOD_HTTP=https://demo.example.com

# Comma-separated browser origins allowed for cross-origin API calls (public mode).
# Defaults to NL_PUBLIC_HTTP when NL_PUBLIC_MODE is on and this is unset.
# NL_CORS_ORIGINS=https://demo.example.com

# --- Data paths (Docker uses /data volume) ---
# NL_DATA_ROOT=/data
# NL_MODERATION_LOG=/data/moderation.jsonl
# NL_SP_STORE=/data/sp-profiles

# --- Phase F demo deploy (see docs/NL_DEPLOY.md) ---
# NL_DEMO_DOMAIN=demo.example.com
# CADDY_ACME_EMAIL=you@example.com
# NL_SESSION_IMAGE=ghcr.io/surrplexie/nexoralive/session-server:latest

# --- Phase G hosted demo loop (auto session + sidecar bridge in docker-compose.demo.yml) ---
# NL_DEMO_MODE=true
# NL_DEMO_CONFIG=demo.nle
# NL_DEMO_RESET_INTERVAL_MINUTES=60
# NL_DEMO_BRIDGE_INTERVAL=8

# --- Phase H spectator UX (public landing + try-a-rule triggers) ---
# NL_SPECTATOR_TRIGGERS=true
# NL_SPECTATOR_TRIGGER_RATE_PER_MIN=12
# NL_SPECTATOR_FEED_MAX=100

# --- Phase K demo hardening (rate limits, WS caps, ops probes) ---
# NL_HARDENING=true
# NL_ADMIT_RATE_PER_MIN=120
# NL_PUBLIC_READ_RATE_PER_MIN=300
# NL_WS_MAX_CONNECTIONS=16
# NL_WS_MAX_CONNECTIONS_PER_IP=4
# NL_WS_CONNECT_RATE_PER_MIN=30
# NL_DEMO_SESSION_MAX_HOURS=12

# --- Phase L platform identity & game ownership ---
# NL_IDENTITY_ENABLED=true
# NL_OWNERSHIP_MODE=mock
# NL_OWNERSHIP_STRICT_UNKNOWN=1
# NL_PUBLIC_BASE_URL=http://127.0.0.1:27020
# NL_STEAM_OPENID_REALM=http://127.0.0.1:27020
# STEAM_WEB_API_KEY=
# NL_IDENTITY_ROOT=/data/identity
# NL_IDENTITY_ENCRYPTION_KEY=base64-32-byte-key-for-linux-token-storage

# --- Phase M social gate (see docs/NL_SOCIAL_GATE.md) ---
# NL_SOCIAL_ENABLED=true
# NL_SOCIAL_MODE=mock
# NL_SOCIAL_ROOT=/data/social
# NL_SOCIAL_MOCK_DATA=/data/social/mock-social.json
# NL_SOCIAL_CACHE_TTL_SEC=300
# NL_LIVE_CHECK_INTERVAL_SEC=60
# TWITCH_CLIENT_ID=
# TWITCH_ACCESS_TOKEN=

# --- Phase N fork catalog (see docs/NL_FORK_CATALOG.md) ---
# NL_FORK_CATALOG_ENABLED=true
# NL_FORK_CATALOG_ROOT=/data/fork-catalog
# NL_FORK_CATALOG_MANIFEST=/data/fork-catalog/catalog.json
# NL_FORK_CATALOG_MAX_MAJORS=3
# NL_FORK_CATALOG_CUSTOM_MAJOR_BETA=true
# NL_SAMPLES_ROOT=/app/samples
# STEAM_WEB_API_KEY=your-steam-web-api-key

# --- Phase O fork orchestrator (see docs/NL_FORK_ORCHESTRATOR.md) ---
# NL_FORK_ORCHESTRATOR_ENABLED=true
# NL_FORK_ORCHESTRATOR_MODE=mock
# NL_FORK_DESTROY_GRACE_SEC=30
# NL_FORK_SESSION_MAX_HOURS=12
# NL_FORK_RESERVED_PRIVILEGED_SLOTS=2
# NL_FORK_DOCKER_IMAGE=nl-fork-hello:latest
# NL_FORK_GAME=hello
# Game-specific images: nl-fork-minecraft:latest, nl-fork-beamng:latest, nl-fork-minecraft-paper:latest
# NL_FORK_ORCHESTRATOR_ROOT=/data/fork-orchestrator
# NL_FORK_IDLE_MINUTES=15

# --- Phase Q partnerships (see docs/NL_PARTNERSHIP.md) ---
# NL_PARTNERSHIP_ENABLED=true
# NL_PARTNERSHIP_GATE_ADMIT=1
# NL_PARTNERSHIP_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
# NL_PARTNERSHIP_ROOT=/data/partnership

# --- Phase R NL Client (see docs/NL_CLIENT.md) ---
# NL_CLIENT_SESSION_URL=http://127.0.0.1:27020

# --- Phase S fleet ops (see docs/NL_FLEET_OPS.md) ---
# NL_FLEET_ENABLED=true
# NL_FLEET_ROOT=/data/fleet
# NL_FLEET_DEFAULT_REGION=us-east
# NL_FLEET_MAX_CONCURRENT=128
# NL_FLEET_MIN_WARM=2
# NL_FLEET_MIN_TWITCH_FOLLOWERS=50
# NL_FLEET_FORK_CREATE_RATE_PER_MIN=30
# NL_FLEET_MOD_RETENTION_DAYS=730
# NL_FLEET_RELAY_WS_TEMPLATE=wss://relay-{region}.nl.example.com/fork/{session}
# NL_FLEET_TURN_URI=turn:turn.nl.example.com:3478
# NL_FLEET_DEV_TWITCH_FOLLOWERS=100
# NL_FLEET_STAGING_DEV=true
# NL_FLEET_PRODUCTION_READY=false
# NL_FLEET_FORK_CREATE_P99_MS=15000
# NL_FORK_ORCHESTRATOR_MODE=mock
# NL_FORK_K8S_NAMESPACE=nl-fork
# NL_FORK_K8S_KUBECONFIG=
